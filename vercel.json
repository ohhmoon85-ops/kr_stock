{
  "version": 2,
  "routes": [
    { "src": "/api/health",   "dest": "/api/index.py" },
    { "src": "/api/evaluate", "dest": "/api/index.py" },
    { "src": "/api",          "dest": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/evaluate",
      "schedule": "0 23 * * 0"
    }
  ]
}
